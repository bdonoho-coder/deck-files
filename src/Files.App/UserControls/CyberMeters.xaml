<UserControl
	x:Class="Files.App.UserControls.CyberMeters"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Files.App.UserControls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsTabStop="False"
	Visibility="{StaticResource LookChamfer}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="MeterLabelStyle" TargetType="TextBlock">
			<Setter Property="CharacterSpacing" Value="{StaticResource LookSpacing}" />
			<Setter Property="FontFamily" Value="{StaticResource LookFont}" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
	</UserControl.Resources>

	<!--  Cyber look filler under the side panel: fixed drives as dot-matrix meters (a thick dashed line reads as a row of square dots; the lit part is clipped to the used share)  -->
	<StackPanel Padding="14,6,14,10" Spacing="6">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Rectangle
				Width="5"
				Height="5"
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				Fill="{ThemeResource LookAccent}" />
			<TextBlock
				Margin="13,0,0,0"
				VerticalAlignment="Center"
				Foreground="{ThemeResource LookLabelForeground}"
				Style="{StaticResource MeterLabelStyle}"
				Text="{x:Bind Title}" />
			<Rectangle
				Grid.Column="1"
				Height="1"
				Margin="10,1,0,0"
				VerticalAlignment="Center"
				Opacity="0.6"
				Stroke="{ThemeResource LookAccent}"
				StrokeDashArray="2,2"
				StrokeThickness="1" />
		</Grid>
		<ItemsControl ItemsSource="{x:Bind Meters}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Spacing="6" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:DriveMeter">
					<StackPanel Spacing="3">
						<Grid>
							<TextBlock Style="{StaticResource MeterLabelStyle}" Text="{x:Bind Name}" />
							<TextBlock
								HorizontalAlignment="Right"
								Foreground="{ThemeResource LookLabelForeground}"
								Style="{StaticResource MeterLabelStyle}"
								Text="{x:Bind Percent}" />
						</Grid>
						<!--  Canvas: the lines never feed their length back into layout  -->
						<Canvas Height="6" SizeChanged="Track_SizeChanged">
							<Line
								Opacity="0.25"
								Stroke="{ThemeResource LookAccent}"
								StrokeDashArray="1,0.67"
								StrokeThickness="6"
								X1="0"
								X2="{x:Bind TrackWidth, Mode=OneWay}"
								Y1="3"
								Y2="3" />
							<Line
								Stroke="{ThemeResource LookAccent}"
								StrokeDashArray="1,0.67"
								StrokeThickness="6"
								X1="0"
								X2="{x:Bind LitWidth, Mode=OneWay}"
								Y1="3"
								Y2="3" />
						</Canvas>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>

</UserControl>
