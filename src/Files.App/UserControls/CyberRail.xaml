<UserControl
	x:Class="Files.App.UserControls.CyberRail"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Files.App.UserControls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="RailLabelStyle" TargetType="TextBlock">
			<Setter Property="CharacterSpacing" Value="{StaticResource LookSpacing}" />
			<Setter Property="FontFamily" Value="{StaticResource LookFont}" />
			<Setter Property="FontSize" Value="8" />
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>

		<!--  Place key: 48 px chamfered plate (corner cut top-left and bottom-right), line icon, code label; solid accent while it is the open place  -->
		<Style x:Key="PlaceKeyStyle" TargetType="Button">
			<Setter Property="Width" Value="48" />
			<Setter Property="Height" Value="48" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="UseSystemFocusVisuals" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid x:Name="Root">
							<Path
								x:Name="Glow"
								Data="M8,0 H48 V40 L40,48 H0 V8 Z"
								Opacity="0"
								Stroke="{ThemeResource LookAccent}"
								StrokeThickness="5" />
							<Path
								x:Name="Plate"
								Data="M8,0 H48 V40 L40,48 H0 V8 Z"
								Fill="{ThemeResource ControlFillColorDefaultBrush}"
								Stroke="{ThemeResource LookCardBorder}"
								StrokeThickness="1" />
							<ContentPresenter
								x:Name="KeyContent"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Content="{TemplateBinding Content}" />
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />
									<VisualState x:Name="PointerOver">
										<VisualState.Setters>
											<Setter Target="Plate.Stroke" Value="{ThemeResource LookAccent}" />
											<Setter Target="Plate.Fill" Value="{ThemeResource LookCardHover}" />
											<Setter Target="Glow.Opacity" Value="0.25" />
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Pressed">
										<VisualState.Setters>
											<Setter Target="Plate.Stroke" Value="{ThemeResource LookAccent}" />
											<Setter Target="Plate.Fill" Value="{ThemeResource LookCardPressed}" />
											<Setter Target="Glow.Opacity" Value="0.35" />
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Disabled">
										<VisualState.Setters>
											<Setter Target="KeyContent.Opacity" Value="0.5" />
										</VisualState.Setters>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<!--  Cyber look: the main places as big drawn icons on a left rail; the open place is drawn as a solid accent key  -->
	<Grid
		Width="72"
		Padding="0,10,0,10"
		BorderBrush="{ThemeResource LookDivider}"
		BorderThickness="0,0,1,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ItemsControl ItemsSource="{x:Bind Places}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel HorizontalAlignment="Center" Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:RailPlace">
					<Grid>
						<!--  Lit plate behind the key: solid accent + glow while this is the open place  -->
						<Path
							Data="M8,0 H48 V40 L40,48 H0 V8 Z"
							Fill="{ThemeResource LookAccent}"
							Opacity="0.3"
							Stroke="{ThemeResource LookAccent}"
							StrokeThickness="5"
							Visibility="{x:Bind IsOn, Mode=OneWay}" />
						<Path
							Data="M8,0 H48 V40 L40,48 H0 V8 Z"
							Fill="{ThemeResource LookAccent}"
							Visibility="{x:Bind IsOn, Mode=OneWay}" />
						<Button
							AutomationProperties.Name="{x:Bind Name}"
							Click="Place_Click"
							Style="{StaticResource PlaceKeyStyle}"
							Tag="{x:Bind}"
							ToolTipService.ToolTip="{x:Bind Name}">
							<StackPanel Spacing="3">
								<Viewbox Width="20" Height="20">
									<Path
										Width="24"
										Height="24"
										Data="{x:Bind Icon}"
										Stroke="{x:Bind local:CyberRail.Ink(IsOn), Mode=OneWay}"
										StrokeEndLineCap="Round"
										StrokeLineJoin="Round"
										StrokeStartLineCap="Round"
										StrokeThickness="1.6" />
								</Viewbox>
								<TextBlock
									Foreground="{x:Bind local:CyberRail.Ink(IsOn), Mode=OneWay}"
									Style="{StaticResource RailLabelStyle}"
									Text="{x:Bind Code}" />
							</StackPanel>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!--  Vertical label: a Canvas neither constrains nor clips, so the 140 px text can turn -90 degrees around the centre of a 16 x 140 slot  -->
		<Canvas
			Grid.Row="2"
			Width="16"
			Height="140"
			HorizontalAlignment="Center">
			<TextBlock
				Canvas.Left="-62"
				Canvas.Top="62"
				Width="140"
				Height="16"
				Foreground="{ThemeResource LookLabelForeground}"
				RenderTransformOrigin="0.5,0.5"
				Style="{StaticResource RailLabelStyle}"
				Text="{x:Bind Footer}"
				TextAlignment="Center">
				<TextBlock.RenderTransform>
					<RotateTransform Angle="-90" />
				</TextBlock.RenderTransform>
			</TextBlock>
		</Canvas>
	</Grid>

</UserControl>
