<UserControl
	x:Class="Files.App.UserControls.HudReadout"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsHitTestVisible="False"
	mc:Ignorable="d">

	<!--  Theme readout in the title bar: theme id, system drive use, clock. The HUD look shows all of it; the minimal look only the clock.  -->
	<StackPanel
		VerticalAlignment="Center"
		Orientation="Horizontal"
		Spacing="14">

		<!--  Retro: three chevrons, like the circuit-trace markers on cyberpunk HUD panels  -->
		<StackPanel
			VerticalAlignment="Center"
			Orientation="Horizontal"
			Spacing="-2"
			Visibility="{StaticResource LookRetro}">
			<FontIcon
				FontSize="8"
				Foreground="{ThemeResource LookAccent}"
				Glyph="&#xE76B;" />
			<FontIcon
				FontSize="8"
				Foreground="{ThemeResource LookAccent}"
				Glyph="&#xE76B;"
				Opacity="0.7" />
			<FontIcon
				FontSize="8"
				Foreground="{ThemeResource LookAccent}"
				Glyph="&#xE76B;"
				Opacity="0.4" />
		</StackPanel>

		<TextBlock
			VerticalAlignment="Center"
			CharacterSpacing="{StaticResource LookSpacing}"
			FontFamily="{StaticResource LookFont}"
			FontSize="11"
			FontWeight="SemiBold"
			Foreground="{ThemeResource LookLabelForeground}"
			Text="{x:Bind ThemeLabel, Mode=OneWay}"
			Visibility="{StaticResource LookDecor}">
			<TextBlock.RenderTransform>
				<TranslateTransform x:Name="GlitchShift" />
			</TextBlock.RenderTransform>
		</TextBlock>

		<TextBlock
			VerticalAlignment="Center"
			CharacterSpacing="{StaticResource LookSpacing}"
			FontFamily="{StaticResource LookFont}"
			FontSize="11"
			FontWeight="SemiBold"
			Foreground="{ThemeResource LookLabelForeground}"
			Text="{x:Bind DriveLabel, Mode=OneWay}"
			Visibility="{StaticResource LookDecor}" />

		<TextBlock
			VerticalAlignment="Center"
			CharacterSpacing="{StaticResource LookSpacing}"
			FontFamily="{StaticResource LookFont}"
			FontSize="12"
			FontWeight="SemiBold"
			Foreground="{ThemeResource LookLabelForeground}"
			Text="{x:Bind Clock, Mode=OneWay}" />
	</StackPanel>

</UserControl>
