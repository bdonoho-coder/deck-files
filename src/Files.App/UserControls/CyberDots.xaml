<UserControl
	x:Class="Files.App.UserControls.CyberDots"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsHitTestVisible="False"
	IsTabStop="False"
	SizeChanged="CyberDots_SizeChanged"
	mc:Ignorable="d">

	<!--  Cyber look filler: a dim dot grid behind the file list, so empty space reads as a HUD panel. One Path holds every dot; the Canvas keeps it out of layout.  -->
	<Canvas>
		<Path
			x:Name="Dots"
			Opacity="0.35"
			Fill="{ThemeResource LookLabelForeground}" />
	</Canvas>

</UserControl>
