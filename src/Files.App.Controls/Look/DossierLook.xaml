<!--  Dossier look: the HUD look (merged first) plus file cards drawn as dossier plates: dark fill, thin accent outline, accent tag notch, stats as code labels.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<SolidColorBrush
		x:Key="LookCardFill"
		Opacity="0.9"
		Color="{ThemeResource SystemAccentColorDark3}" />
	<SolidColorBrush
		x:Key="LookCardStroke"
		Opacity="0.3"
		Color="{ThemeResource SystemAccentColor}" />
	<Visibility x:Key="LookNotch">Visible</Visibility>

</ResourceDictionary>
