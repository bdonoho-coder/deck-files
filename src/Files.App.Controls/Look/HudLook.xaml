<!--  HUD look: caps code labels, scale lines, corner brackets, angled tab, square corners. Colors follow the Windows accent color, which the theme picker sets.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="LookCardFill" ResourceKey="CardBackgroundFillColorDefaultBrush" />
			<StaticResource x:Key="LookCardStroke" ResourceKey="CardStrokeColorDefaultBrush" />
			<StaticResource x:Key="LookCrumbForeground" ResourceKey="BreadcrumbBarForegroundBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="LookCardFill" ResourceKey="CardBackgroundFillColorDefaultBrush" />
			<StaticResource x:Key="LookCardStroke" ResourceKey="CardStrokeColorDefaultBrush" />
			<StaticResource x:Key="LookCrumbForeground" ResourceKey="BreadcrumbBarForegroundBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!--  Shared switches (MinimalLook.xaml defines the same keys)  -->
	<FontFamily x:Key="LookFont">HUD Face, Bahnschrift, Segoe UI Variable Text</FontFamily>
	<!--  Chevrons in the side panel and path bar; TreeLook.xaml swaps them for node squares  -->
	<Visibility x:Key="LookChevron">Visible</Visibility>
	<Visibility x:Key="LookNode">Collapsed</Visibility>
	<x:String x:Key="LookCrumbGlyph">&#xE76C;</x:String>
	<Visibility x:Key="LookTabNode">Collapsed</Visibility>
	<Visibility x:Key="LookTabUnderline">Collapsed</Visibility>
	<!--  Console panes, key-cap toolbar labels and the left tab rail; DeckLook.xaml turns them on  -->
	<Visibility x:Key="LookPane">Collapsed</Visibility>
	<SolidColorBrush x:Key="LookPaneStroke" Color="Transparent" />
	<Thickness x:Key="LookPaneThickness">0</Thickness>
	<Thickness x:Key="LookInfoTabsMargin">12</Thickness>
	<CommandBarLabelPosition x:Key="LookToolbarLabel">Collapsed</CommandBarLabelPosition>
	<Visibility x:Key="LookTopTab">Visible</Visibility>
	<!--  Retro extras (AcidLook.xaml): chevrons + glitch readout, CRT scan lines, dashed circuit lines instead of solid scale lines  -->
	<Visibility x:Key="LookChamfer">Collapsed</Visibility>
	<Thickness x:Key="LookInfoPaneThickness">1</Thickness>
	<Visibility x:Key="LookRetro">Collapsed</Visibility>
	<Visibility x:Key="LookLineSolid">Visible</Visibility>
	<Visibility x:Key="LookLineDashed">Collapsed</Visibility>
	<!--  Cards view: square plates; DossierLook.xaml adds the dark fill, accent stroke and tag notch  -->
	<CornerRadius x:Key="LookCardRadius">0</CornerRadius>
	<Visibility x:Key="LookNotch">Collapsed</Visibility>
	<x:Int32 x:Key="LookSpacing">60</x:Int32>
	<Visibility x:Key="LookDecor">Visible</Visibility>
	<Visibility x:Key="LookHeaderName">Collapsed</Visibility>
	<SolidColorBrush x:Key="LookAccent" Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush x:Key="LookLabelForeground" Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="LookDivider"
		Opacity="0.35"
		Color="{ThemeResource SystemAccentColor}" />

	<!--  Tabs: solid accent tab with a 45 degree cut, dark text (AccentDark3 = the theme background)  -->
	<GridLength x:Key="LookTabCutWidth">30</GridLength>
	<Thickness x:Key="LookSelectedTabPadding">8,3,34,3</Thickness>
	<Visibility x:Key="LookHudTab">Visible</Visibility>
	<Visibility x:Key="LookRoundTab">Collapsed</Visibility>
	<SolidColorBrush x:Key="LookTabSelectedForeground" Color="{ThemeResource SystemAccentColorDark3}" />
	<SolidColorBrush x:Key="LookTabSelectedIconForeground" Color="{ThemeResource SystemAccentColorDark3}" />
	<SolidColorBrush x:Key="LookTabSelectedCloseForeground" Color="{ThemeResource SystemAccentColorDark3}" />

	<!--  Address bar: square, accent outline  -->
	<CornerRadius x:Key="LookOmnibarCornerRadius">0</CornerRadius>
	<CornerRadius x:Key="LookOmnibarModeCornerRadius">0</CornerRadius>
	<SolidColorBrush
		x:Key="LookOmnibarBorder"
		Opacity="0.6"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush x:Key="LookOmnibarBorderPointerOver" Color="{ThemeResource SystemAccentColor}" />

	<!--  Side panel: accent tint + outline on the selected row, full-height 3 px bar  -->
	<SolidColorBrush
		x:Key="LookSidebarSelected"
		Opacity="0.16"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="LookSidebarSelectedBorder"
		Opacity="0.5"
		Color="{ThemeResource SystemAccentColor}" />
	<x:Double x:Key="LookIndicatorHeight">NaN</x:Double>
	<VerticalAlignment x:Key="LookIndicatorAlign">Stretch</VerticalAlignment>
	<x:Double x:Key="LookIndicatorRadius">0</x:Double>

	<!--  Status bar code labels  -->
	<Style x:Key="LookStatusTextStyle" TargetType="TextBlock">
		<Setter Property="CharacterSpacing" Value="60" />
		<Setter Property="FontFamily" Value="{StaticResource LookFont}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!--  HUD only: square corners on every control and pop-up (WinUI reads these two keys)  -->
	<CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
	<CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

	<!--  HUD only: file list rows and grid tiles square, accent tint when selected  -->
	<CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
	<CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">0</CornerRadius>
	<CornerRadius x:Key="GridViewItemCornerRadius">0</CornerRadius>
	<SolidColorBrush
		x:Key="GridViewItemBackgroundSelected"
		Opacity="0.18"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="GridViewItemBackgroundSelectedPointerOver"
		Opacity="0.24"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="GridViewItemBackgroundSelectedPressed"
		Opacity="0.30"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="ListViewItemBackgroundSelected"
		Opacity="0.18"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="ListViewItemBackgroundSelectedPointerOver"
		Opacity="0.24"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="ListViewItemBackgroundSelectedPressed"
		Opacity="0.30"
		Color="{ThemeResource SystemAccentColor}" />

	<!--  HUD only: toolbar buttons and menus with accent outline and tint  -->
	<SolidColorBrush
		x:Key="LookCardBorder"
		Opacity="0.35"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="LookCardHover"
		Opacity="0.12"
		Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush
		x:Key="LookCardPressed"
		Opacity="0.22"
		Color="{ThemeResource SystemAccentColor}" />
	<StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="LookCardHover" />
	<StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="LookCardPressed" />
	<StaticResource x:Key="AppBarButtonBackgroundSubMenuOpened" ResourceKey="LookCardPressed" />
	<StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="LookAccent" />
	<StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="LookAccent" />
	<StaticResource x:Key="AppBarButtonBorderBrushSubMenuOpened" ResourceKey="LookAccent" />
	<StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="LookAccent" />
	<StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="LookCardHover" />
	<StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="LookCardPressed" />
	<StaticResource x:Key="MenuFlyoutSubItemBackgroundPointerOver" ResourceKey="LookCardHover" />
	<StaticResource x:Key="MenuFlyoutSubItemBackgroundPressed" ResourceKey="LookCardPressed" />
	<StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="LookCardHover" />

	<!--  Home cards: square panel, thin accent outline, accent corner brackets  -->
	<Style x:Key="LookCardButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource LookCardBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
						<Border
							x:Name="HoverFill"
							Background="Transparent"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" />

						<Path
							Width="8"
							Height="8"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							Data="M0,8 L0,0 L8,0"
							Stroke="{ThemeResource LookAccent}"
							StrokeThickness="2" />
						<Path
							Width="8"
							Height="8"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Data="M0,0 L8,0 L8,8"
							Stroke="{ThemeResource LookAccent}"
							StrokeThickness="2" />
						<Path
							Width="8"
							Height="8"
							HorizontalAlignment="Left"
							VerticalAlignment="Bottom"
							Data="M0,0 L0,8 L8,8"
							Stroke="{ThemeResource LookAccent}"
							StrokeThickness="2" />
						<Path
							Width="8"
							Height="8"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Data="M8,0 L8,8 L0,8"
							Stroke="{ThemeResource LookAccent}"
							StrokeThickness="2" />

						<ContentPresenter
							x:Name="ContentPresenter"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
							AutomationProperties.AccessibilityView="Raw"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							ContentTransitions="{TemplateBinding ContentTransitions}"
							Foreground="{TemplateBinding Foreground}" />

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="HoverFill.Background" Value="{ThemeResource LookCardHover}" />
										<Setter Target="HoverFill.BorderBrush" Value="{ThemeResource LookAccent}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="HoverFill.Background" Value="{ThemeResource LookCardPressed}" />
										<Setter Target="HoverFill.BorderBrush" Value="{ThemeResource LookAccent}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="ContentPresenter.Opacity" Value="0.5" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
