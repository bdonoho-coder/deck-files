<UserControl
	x:Class="Files.App.Controls.ChamferFrame"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsHitTestVisible="False"
	IsTabStop="False"
	SizeChanged="ChamferFrame_SizeChanged"
	Visibility="{StaticResource LookChamfer}"
	mc:Ignorable="d">

	<!--  Cyber look pane frame, like a HUD panel kit: an open outline with corner cuts, a 45 degree step on the top edge, gaps on the left and right edges that end in square nodes, a glow stroke under the line and an accent notch. The geometry is rebuilt for the pane size in code.  -->
	<Grid>
		<Path
			x:Name="Glow"
			Opacity="0.22"
			Stroke="{ThemeResource LookAccent}"
			StrokeThickness="4" />
		<Path
			x:Name="Line"
			Stroke="{ThemeResource LookAccent}"
			StrokeThickness="1" />
		<Path
			x:Name="Nodes"
			Fill="{ThemeResource LookAccent}" />
	</Grid>

</UserControl>
