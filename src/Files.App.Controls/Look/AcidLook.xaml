<!--  Acid Signal retro-cyberpunk overlay: merged after the look's own files whenever the hud-acid theme is active. Dashed circuit-trace lines with square nodes instead of plain scale lines, chevron marks and a glitch flicker in the title bar readout, CRT scan lines over the window (CrtOverlay).  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Visibility x:Key="LookRetro">Visible</Visibility>
	<Visibility x:Key="LookLineSolid">Collapsed</Visibility>
	<Visibility x:Key="LookLineDashed">Visible</Visibility>

</ResourceDictionary>
