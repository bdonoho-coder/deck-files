<UserControl
	x:Class="Files.App.Controls.CyberPlate"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsHitTestVisible="False"
	IsTabStop="False"
	SizeChanged="CyberPlate_SizeChanged"
	mc:Ignorable="d">

	<!--  Cyber look selection plate for side panel rows: cut top-left and bottom-right corners, light accent fill, accent outline, glow, a notch block on the top edge. Geometry is rebuilt for the row size in code; the Canvas keeps it out of layout.  -->
	<Canvas>
		<Path
			x:Name="Glow"
			Opacity="0.22"
			Stroke="{ThemeResource LookAccent}"
			StrokeThickness="3" />
		<Path
			x:Name="Plate"
			Opacity="0.16"
			Fill="{ThemeResource LookAccent}" />
		<Path
			x:Name="Line"
			Stroke="{ThemeResource LookAccent}"
			StrokeThickness="1" />
		<Path
			x:Name="Notch"
			Fill="{ThemeResource LookAccent}" />
	</Canvas>

</UserControl>
