<!--  Cyber Revamp look (board D): the HUD look (merged first) plus console pane headers, a big-icon places rail on the left (CyberRail), and, step by step, file plates, a command bar, an ID-card info pane and filler graphics.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Panes: header strip on; no rectangular outline, the open HUD-kit frame (ChamferFrame) is drawn instead  -->
	<Visibility x:Key="LookPane">Visible</Visibility>
	<SolidColorBrush x:Key="LookPaneStroke" Color="Transparent" />
	<Thickness x:Key="LookPaneThickness">0</Thickness>
	<Thickness x:Key="LookInfoPaneThickness">0</Thickness>
	<Visibility x:Key="LookChamfer">Visible</Visibility>
	<Thickness x:Key="LookInfoTabsMargin">12,44,12,12</Thickness>

	<!--  Tabs: the selected tab is a HUD-kit plate (CyberTab) with accent text, not the solid cut tab  -->
	<Visibility x:Key="LookCyberTab">Visible</Visibility>
	<Visibility x:Key="LookHudTab">Collapsed</Visibility>
	<SolidColorBrush x:Key="LookTabSelectedForeground" Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush x:Key="LookTabSelectedIconForeground" Color="{ThemeResource SystemAccentColor}" />
	<SolidColorBrush x:Key="LookTabSelectedCloseForeground" Color="{ThemeResource SystemAccentColor}" />

	<!--  Address bar: no box outline, the open frame is drawn over it  -->
	<SolidColorBrush x:Key="LookOmnibarBorder" Color="Transparent" />
	<SolidColorBrush
		x:Key="LookOmnibarBorderPointerOver"
		Opacity="0.35"
		Color="{ThemeResource SystemAccentColor}" />

	<!--  Details view rows as plates: filled, spaced, corner cut top-left, extension badge before the name  -->
	<SolidColorBrush x:Key="LookPlateFill" Color="{ThemeResource ControlFillColorDefault}" />
	<Thickness x:Key="LookPlateMargin">0,0,0,4</Thickness>
	<Visibility x:Key="LookBadge">Visible</Visibility>

</ResourceDictionary>
