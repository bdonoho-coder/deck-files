<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:controls="using:Files.App.Controls"
	xmlns:local="using:Files.App.Controls">

	<x:Double x:Key="SidebarOpenPaneLength">300</x:Double>
	<x:Double x:Key="SidebarNegativeOpenPaneLength">-300</x:Double>
	<x:Double x:Key="SidebarCompactOpenPaneLength">56</x:Double>
	<x:Double x:Key="SidebarNegativeCompactOpenPaneLength">-56</x:Double>

	<Style
		x:Key="SidebarEjectButtonStyle"
		BasedOn="{StaticResource DefaultButtonStyle}"
		TargetType="Button">
		<Setter Target="MinWidth" Value="24" />
		<Setter Target="Width" Value="24" />
		<Setter Target="MinHeight" Value="24" />
		<Setter Target="Height" Value="24" />
		<Setter Target="Padding" Value="0" />
		<Setter Target="BorderThickness" Value="0" />
		<Setter Target="CornerRadius" Value="4" />
		<Setter Target="Background" Value="Transparent" />
	</Style>

	<Style
		x:Key="SidebarFavouritesPinnedIcon"
		BasedOn="{StaticResource App.ThemedIcons.Actions.Pinned.12}"
		TargetType="controls:ThemedIcon">
		<Setter Target="MinWidth" Value="12" />
		<Setter Target="Width" Value="12" />
		<Setter Target="MinHeight" Value="12" />
		<Setter Target="Height" Value="12" />
		<Setter Target="Padding" Value="0" />
	</Style>

	<Style TargetType="local:SidebarItem">
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:SidebarItem">
					<Grid x:Name="RootPanel" Padding="4,0,4,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!--  Drag Target Indicator  -->
						<Rectangle
							x:Name="DragTargetIndicator"
							Grid.ColumnSpan="3"
							Height="2"
							Margin="4,-2"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top"
							AutomationProperties.AccessibilityView="Raw"
							Fill="{ThemeResource AccentFillColorDefaultBrush}"
							RadiusX="4"
							RadiusY="4"
							Visibility="Collapsed" />

						<!--  HUD pin group label (from pin-groups.txt), above the first pin of a group  -->
						<Grid
							x:Name="PinGroupHeader"
							Height="22"
							Margin="10,4,8,0"
							VerticalAlignment="Top"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Rectangle
								Width="6"
								Height="6"
								Margin="0,0,8,0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Fill="{ThemeResource LookAccent}"
								Visibility="{StaticResource LookDecor}" />
							<TextBlock
								Margin="14,0,0,0"
								VerticalAlignment="Center"
								CharacterSpacing="{StaticResource LookSpacing}"
								FontFamily="{StaticResource LookFont}"
								FontSize="11"
								FontWeight="SemiBold"
								Foreground="{ThemeResource LookLabelForeground}"
								Opacity="0.85"
								Text="{TemplateBinding HudGroupLabel}" />
							<Rectangle
								Grid.Column="1"
								Height="1"
								Margin="10,1,0,0"
								VerticalAlignment="Center"
								Fill="{ThemeResource LookAccent}"
								Opacity="0.25"
								Visibility="{StaticResource LookLineSolid}" />
							<!--  Retro: dashed circuit trace ending in a node square  -->
							<Rectangle
								Grid.Column="1"
								Height="1"
								Margin="10,1,8,0"
								VerticalAlignment="Center"
								Opacity="0.5"
								Stroke="{ThemeResource LookAccent}"
								StrokeDashArray="2,2"
								StrokeThickness="1"
								Visibility="{StaticResource LookLineDashed}" />
							<Rectangle
								Grid.Column="1"
								Width="5"
								Height="5"
								Margin="0,1,0,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Fill="{ThemeResource LookAccent}"
								Visibility="{StaticResource LookLineDashed}" />
						</Grid>

						<!--  Focusable Visual  -->
						<Border
							x:Name="ElementBorder"
							Grid.Row="0"
							Height="32"
							Background="Transparent">
							<Grid
								x:Name="ElementGrid"
								Margin="0,2,0,2"
								HorizontalAlignment="Stretch"
								Background="{ThemeResource SubtleFillColorTransparentBrush}"
								BackgroundSizing="InnerBorderEdge"
								BorderThickness="1"
								CornerRadius="{ThemeResource ControlCornerRadius}"
								IsTabStop="True"
								TabFocusNavigation="Once"
								ToolTipService.ToolTip="{TemplateBinding ToolTip}"
								UseSystemFocusVisuals="True">
								<Grid.ColumnDefinitions>
									<!--  Selection Indicator  -->
									<ColumnDefinition Width="3" />
									<!--  Tree-view depth indent (content-only; row background still spans full width)  -->
									<ColumnDefinition Width="Auto" />
									<!--  Chevron. Fixed 16px so expandable and non-expandable rows stay aligned; the OwnerDoesNotSupportExpansion and Compact visual states collapse it to 0 when the chevron isn't applicable.  -->
									<ColumnDefinition x:Name="ChevronColumnDefinition" Width="16" />
									<!--  Icon  -->
									<ColumnDefinition Width="Auto" />
									<!--  Text  -->
									<ColumnDefinition Width="*" />
									<!--  Decorator  -->
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<!--  Cyber look: chamfered selection plate behind the whole row, shown by LookCyberSelect in the Selected state  -->
								<controls:CyberPlate
									x:Name="CyberSelect"
									Grid.ColumnSpan="6"
									Visibility="Collapsed" />

								<!--  Selection Rectangle  -->
								<Rectangle
									x:Name="SelectionIndicator"
									Grid.Column="0"
									Width="3"
									Height="{StaticResource LookIndicatorHeight}"
									HorizontalAlignment="Left"
									VerticalAlignment="{StaticResource LookIndicatorAlign}"
									AutomationProperties.AccessibilityView="Raw"
									Fill="{ThemeResource LookAccent}"
									Opacity="0"
									RadiusX="{StaticResource LookIndicatorRadius}"
									RadiusY="{StaticResource LookIndicatorRadius}" />

								<!--  Depth indent spacer (width = NestingLevel * 16). Node Tree look: dotted branch line down the indent plus a stub to the node.  -->
								<Grid Grid.Column="1" Width="{TemplateBinding IndentWidth}">
									<Rectangle
										Width="1"
										Margin="0,-4,8,-4"
										HorizontalAlignment="Right"
										VerticalAlignment="Stretch"
										Opacity="0.5"
										Stroke="{ThemeResource LookAccent}"
										StrokeDashArray="1,2"
										StrokeThickness="1"
										Visibility="{TemplateBinding TreeLine}" />
									<Rectangle
										Width="8"
										Height="1"
										HorizontalAlignment="Right"
										VerticalAlignment="Center"
										Opacity="0.5"
										Stroke="{ThemeResource LookAccent}"
										StrokeDashArray="1,2"
										StrokeThickness="1"
										Visibility="{TemplateBinding TreeLine}" />
								</Grid>

								<!--  Own pointer surface so chevron clicks only toggle expansion (no row invoke / selection).  -->
								<Border
									x:Name="ChevronContainer"
									Grid.Column="2"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Background="Transparent"
									Opacity="{TemplateBinding ContentOpacity}">
									<Grid>
										<!--  Chevron (rotates from right → down on expand).  -->
										<FontIcon
											x:Name="ExpandCollapseChevron"
											Width="12"
											Height="12"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											AutomationProperties.AccessibilityView="Raw"
											FontFamily="{StaticResource SymbolThemeFontFamily}"
											FontSize="10"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Glyph="&#xE76C;"
											IsTextScaleFactorEnabled="False"
											RenderTransformOrigin="0.5,0.5"
											Visibility="Collapsed">
											<FontIcon.RenderTransform>
												<RotateTransform x:Name="ExpandCollapseChevronRotateTransform" Angle="0" />
											</FontIcon.RenderTransform>
										</FontIcon>
										<!--  Node Tree look: square node mark, filled while expanded  -->
										<Rectangle
											x:Name="NodeDot"
											Width="7"
											Height="7"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Fill="Transparent"
											Stroke="{ThemeResource LookAccent}"
											StrokeThickness="1"
											Visibility="{StaticResource LookNode}" />
									</Grid>
								</Border>

								<!--  Icon  -->
								<ContentPresenter
									x:Name="IconPresenter"
									Grid.Column="3"
									Width="16"
									Height="16"
									Margin="4,0,0,0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									AutomationProperties.AccessibilityView="Raw"
									Content="{TemplateBinding Icon}"
									Opacity="{TemplateBinding ContentOpacity}" />

								<!--  Text  -->
								<TextBlock
									x:Name="ItemNameTextBlock"
									Grid.Column="4"
									Margin="12,0,12,2"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Center"
									AutomationProperties.AccessibilityView="Raw"
									FontFamily="{ThemeResource ContentControlThemeFontFamily}"
									LineHeight="16"
									Opacity="{TemplateBinding ContentOpacity}"
									Text="{TemplateBinding HudDisplayText}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />

								<!--  HUD section header: code label + scale line (shown instead of the name on headers)  -->
								<Grid
									x:Name="HudHeader"
									Grid.Column="4"
									Margin="8,0,8,0"
									VerticalAlignment="Center"
									Opacity="{TemplateBinding ContentOpacity}"
									Visibility="Collapsed">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										CharacterSpacing="{StaticResource LookSpacing}"
										FontFamily="{StaticResource LookFont}"
										FontSize="12"
										FontWeight="SemiBold"
										Foreground="{ThemeResource LookAccent}"
										Text="{TemplateBinding HudLabel}" />
									<Rectangle
										Grid.Column="1"
										Height="1"
										Margin="10,1,0,0"
										VerticalAlignment="Center"
										Fill="{ThemeResource LookAccent}"
										Opacity="0.4"
										Visibility="{StaticResource LookLineSolid}" />
									<!--  Retro: dashed circuit trace ending in a node square  -->
									<Rectangle
										Grid.Column="1"
										Height="1"
										Margin="10,1,8,0"
										VerticalAlignment="Center"
										Opacity="0.6"
										Stroke="{ThemeResource LookAccent}"
										StrokeDashArray="2,2"
										StrokeThickness="1"
										Visibility="{StaticResource LookLineDashed}" />
									<Rectangle
										Grid.Column="1"
										Width="5"
										Height="5"
										Margin="0,1,0,0"
										HorizontalAlignment="Right"
										VerticalAlignment="Center"
										Fill="{ThemeResource LookAccent}"
										Visibility="{StaticResource LookLineDashed}" />
								</Grid>

								<!--  Decorator  -->
								<ContentPresenter
									x:Name="ItemDecoratorPresenter"
									Grid.Column="5"
									Width="28"
									Margin="0"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									BorderThickness="0"
									Content="{TemplateBinding Decorator}"
									Opacity="{TemplateBinding ContentOpacity}"
									Visibility="Collapsed" />

								<!--  Drop-into target highlight  -->
								<Border
									x:Name="DragOnTopIndicator"
									Grid.ColumnSpan="6"
									Margin="-1"
									BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
									BorderThickness="2"
									CornerRadius="{ThemeResource ControlCornerRadius}"
									IsHitTestVisible="False"
									Visibility="Collapsed" />

								<!--  Overflow  -->
								<FlyoutBase.AttachedFlyout>
									<Flyout x:Name="ChildrenFlyout" Placement="Right">
										<Flyout.FlyoutPresenterStyle>
											<Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
												<Setter Target="Padding" Value="0,4" />
												<Setter Target="MinWidth" Value="200" />
												<Setter Target="MinHeight" Value="20" />
											</Style>
										</Flyout.FlyoutPresenterStyle>
										<ItemsRepeater
											x:Name="FlyoutChildrenPresenter"
											HorizontalAlignment="Stretch"
											AutomationProperties.AccessibilityView="Content"
											XYFocusKeyboardNavigation="Enabled">
											<ItemsRepeater.ItemTemplate>
												<DataTemplate>
													<local:SidebarItem
														IsInFlyout="True"
														Item="{Binding}"
														UseItemPresentation="True" />
												</DataTemplate>
											</ItemsRepeater.ItemTemplate>
										</ItemsRepeater>
									</Flyout>
								</FlyoutBase.AttachedFlyout>
							</Grid>
						</Border>

						<VisualStateManager.VisualStateGroups>

							<VisualStateGroup x:Name="PinGroupLabelStates">
								<VisualState x:Name="NoPinGroupLabel" />
								<VisualState x:Name="PinGroupLabel">
									<VisualState.Setters>
										<Setter Target="PinGroupHeader.Visibility" Value="Visible" />
										<Setter Target="ElementBorder.Margin" Value="0,26,0,0" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ExpansionStates">

								<VisualState x:Name="NoExpansion">
									<VisualState.Setters>
										<Setter Target="ItemDecoratorPresenter.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="NoChildren">
									<VisualState.Setters>
										<Setter Target="ItemNameTextBlock.Margin" Value="8,0,12,0" />
										<Setter Target="ItemNameTextBlock.FontWeight" Value="SemiBold" />
										<Setter Target="ItemNameTextBlock.Visibility" Value="{StaticResource LookHeaderName}" />
										<Setter Target="HudHeader.Visibility" Value="{StaticResource LookDecor}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Expanded">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevron.Visibility" Value="{StaticResource LookChevron}" />
										<Setter Target="ItemNameTextBlock.Margin" Value="8,0,12,0" />
										<Setter Target="ItemNameTextBlock.FontWeight" Value="SemiBold" />
										<Setter Target="ItemNameTextBlock.Visibility" Value="{StaticResource LookHeaderName}" />
										<Setter Target="HudHeader.Visibility" Value="{StaticResource LookDecor}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="Collapsed">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevron.Visibility" Value="{StaticResource LookChevron}" />
										<Setter Target="ItemNameTextBlock.Margin" Value="8,0,12,0" />
										<Setter Target="ItemNameTextBlock.FontWeight" Value="SemiBold" />
										<Setter Target="ItemNameTextBlock.Visibility" Value="{StaticResource LookHeaderName}" />
										<Setter Target="HudHeader.Visibility" Value="{StaticResource LookDecor}" />
									</VisualState.Setters>
								</VisualState>

								<!--  Tree-view folder rows: chevron toggle but keep regular item styling (icon visible, normal text). Children render in the outer flat list, not nested.  -->
								<VisualState x:Name="LeafWithChildren">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevron.Visibility" Value="{StaticResource LookChevron}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ExpansionIconStates">
								<VisualState x:Name="ExpandedIconNormal">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevronRotateTransform.Angle" Value="90" />
										<Setter Target="NodeDot.Fill" Value="{ThemeResource LookAccent}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="ExpandedIconPressed">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevronRotateTransform.Angle" Value="90" />
										<Setter Target="NodeDot.Fill" Value="{ThemeResource LookAccent}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CollapsedIconNormal">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevronRotateTransform.Angle" Value="0" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CollapsedIconPressed">
									<VisualState.Setters>
										<Setter Target="ExpandCollapseChevronRotateTransform.Angle" Value="0" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="SelectionStates">
								<VisualState x:Name="Unselected" />
								<VisualState x:Name="Selected">
									<VisualState.Setters>
										<Setter Target="SelectionIndicator.Opacity" Value="1" />
										<Setter Target="CyberSelect.Visibility" Value="{StaticResource LookCyberSelect}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource LookSidebarSelectedBorder}" />
										<Setter Target="ElementGrid.Background" Value="{ThemeResource LookSidebarSelected}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="PointerStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="NormalSelected">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource LookSidebarSelected}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource LookSidebarSelectedBorder}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOverSelected">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource LookSidebarSelectedBorder}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PressedSelected">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
										<Setter Target="ElementGrid.BorderBrush" Value="{ThemeResource LookSidebarSelectedBorder}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="DragInsertAbove">
									<VisualState.Setters>
										<Setter Target="DragTargetIndicator.Visibility" Value="Visible" />
										<Setter Target="DragTargetIndicator.VerticalAlignment" Value="Top" />
										<Setter Target="ElementGrid.Margin" Value="4,-2" />
										<Setter Target="ElementGrid.Height" Value="34" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="DragInsertBelow">
									<VisualState.Setters>
										<Setter Target="DragTargetIndicator.Visibility" Value="Visible" />
										<Setter Target="DragTargetIndicator.VerticalAlignment" Value="Bottom" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="DragOnTop">
									<VisualState.Setters>
										<Setter Target="ElementGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
										<Setter Target="DragOnTopIndicator.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="DisplayModes">
								<VisualState x:Name="NonCompact" />
								<VisualState x:Name="Compact">
									<VisualState.Setters>
										<Setter Target="RootPanel.MaxWidth" Value="48" />
										<Setter Target="ItemNameTextBlock.Visibility" Value="Collapsed" />
										<Setter Target="ItemDecoratorPresenter.Width" Value="0" />
										<Setter Target="ChevronColumnDefinition.Width" Value="0" />
										<Setter Target="NodeDot.Visibility" Value="Collapsed" />
										<Setter Target="IconPresenter.Margin" Value="8,0,0,0" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<!--  Owner-level toggle. Separate from per-row ExpansionStates so a leaf inside a tree (which is NoExpansion) still reserves the 16px chevron column for alignment with expandable siblings, while a Settings-style sidebar (SupportsExpansion=false) collapses it for every row.  -->
							<VisualStateGroup x:Name="OwnerExpansionSupport">
								<VisualState x:Name="OwnerSupportsExpansion" />
								<VisualState x:Name="OwnerDoesNotSupportExpansion">
									<VisualState.Setters>
										<Setter Target="ChevronColumnDefinition.Width" Value="0" />
										<Setter Target="NodeDot.Visibility" Value="Collapsed" />
										<Setter Target="IconPresenter.Margin" Value="8,0,0,0" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
